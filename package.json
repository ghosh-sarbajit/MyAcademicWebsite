{
  "name": "sarbajit-ghosh-academic-website",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Academic website of Sarbajit Ghosh, built with Hugo and HugoBlox",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify && pnpm run pagefind",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "pagefind": "^1.4.0",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss": "^4.2.1"
  }
}
